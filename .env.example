# Model provider selected by setup. Supported values: longcat, anthropic, custom, mock.
APP_MODEL_PROVIDER=longcat

# Anthropic-compatible model/API settings.
# Keep real secrets only in .env. Do not commit .env.
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_API_BASE_URL=https://api.longcat.chat/anthropic
ANTHROPIC_API_MODEL=LongCat-Flash-Chat

# Agent runtime settings.
# APP_AGENT_RUNTIME_PROVIDER: mock or claude_agent_sdk.
APP_AGENT_RUNTIME_PROVIDER=claude_agent_sdk
# APP_AGENT_PERMISSION_MODE: dontAsk or manual.
APP_AGENT_PERMISSION_MODE=dontAsk

# Workspace and local app settings.
APP_WORKSPACE_ROOT=./workspaces
APP_TEST_MODE=false
APP_DEMO_MODE=false
APP_DEMO_PROJECT_ID=proj_demo_review
APP_DEMO_RESET_ON_START=false

# Frontend local backend URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:18081
