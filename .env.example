# 第三方 API 配置（必填）
# Anthropic API Key
ANTHROPIC_API_KEY=your_api_key_here --- IGNORE ---
# 自定义 API Base URL（如果使用第三方代理）
ANTHROPIC_API_BASE_URL=https://api.longcat.chat/anthropic
# 使用的模型名称（根据实际情况调整）
ANTHROPIC_API_MODEL=LongCat-Flash-Chat

# Agent Runtime 配置
# 可选值: mock, claude_agent_sdk
APP_AGENT_RUNTIME_PROVIDER=claude_agent_sdk
# 权限模式: dontAsk (自动批准), manual (需要审批)
APP_AGENT_PERMISSION_MODE=dontAsk

# 工作区配置
APP_WORKSPACE_ROOT=./workspaces

# Test mode. Keep false for normal local usage.
APP_TEST_MODE=false

# Demo mode. When true, backend startup resets and seeds a fixed local demo project.
APP_DEMO_MODE=false
APP_DEMO_PROJECT_ID=proj_demo_keemart_promo
APP_DEMO_RESET_ON_START=true
